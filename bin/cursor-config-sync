#!/usr/bin/env zsh
# Push latest ~/.cursor config changes to mcfwesh/cursor-config
set -euo pipefail

CURSOR_DIR="$HOME/.cursor"
EXTERNAL_REPOS_PULL="$HOME/.local/bin/external-repos-pull"

push_if_ahead() {
  local ahead
  ahead="$(git rev-list --count origin/main..HEAD 2>/dev/null || echo 0)"
  if (( ahead > 0 )); then
    echo "cursor-config: ${ahead} local commit(s) not on origin — pushing..."
    git push origin main
    echo "cursor-config: pushed to mcfwesh/cursor-config ✓"
  fi
}

# Refresh plugin caches from ~/external-repos before backing up plugins/cache/
if [[ -x "$EXTERNAL_REPOS_PULL" ]]; then
  "$EXTERNAL_REPOS_PULL" || {
    echo "cursor-config: warning: external-repos-pull failed (continuing)" >&2
  }
fi

cd "$CURSOR_DIR"

status_err="$(mktemp)"
trap 'rm -f "$status_err"' EXIT
if ! status_out="$(git status --porcelain --ignore-submodules=all 2>"$status_err")"; then
  echo "cursor-config: git status failed:" >&2
  cat "$status_err" >&2
  exit 1
fi
if [[ -s "$status_err" ]]; then
  echo "cursor-config: git status warnings:" >&2
  cat "$status_err" >&2
fi

if [[ -z "$status_out" ]]; then
  echo "cursor-config: nothing changed, already up to date."
  push_if_ahead
  exit 0
fi

echo "cursor-config: staging changes..."
git add -A

if [[ -z "$(git diff --cached --name-only)" ]]; then
  echo "cursor-config: nothing staged after filters."
  push_if_ahead
  exit 0
fi

CHANGED=$(git diff --cached --stat | tail -1)
git commit -m "chore: sync cursor config — $(date '+%Y-%m-%d %H:%M')"
echo "cursor-config: committed ($CHANGED)"

git push origin main
echo "cursor-config: pushed to mcfwesh/cursor-config ✓"
